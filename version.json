import { Platform } from "react-native";
import Constants from "expo-constants";

/**
 * Verificação de versão do app contra uma configuração remota.
 *
 * A fonte da verdade é um JSON hospedado por nós (não as lojas): a Play Store
 * não tem API pública de consulta de versão, e um arquivo próprio ainda permite
 * ligar/desligar o aviso e trocar o texto sem publicar build novo.
 *
 * Formato esperado (todos os campos são opcionais; veja
 * `app-version.example.json` na raiz do projeto):
 *
 * ```json
 * {
 *   "enabled": true,
 *   "minVersion": "2.7.48",
 *   "latestVersion": "2.7.50",
 *   "ios": { "latestVersion": "2.7.44" },
 *   "message": { "requiredTitle": "...", "actionLabel": "..." }
 * }
 * ```
 */

/**
 * URL do JSON de versão. Vem do ambiente (.env local, Environment Variables no
 * EAS) seguindo o mesmo padrão das credenciais do Clube Certo.
 *
 * Sem a variável a verificação simplesmente não roda — nenhum aviso aparece.
 */
export const APP_UPDATE_CONFIG_URL = process.env.EXPO_PUBLIC_APP_UPDATE_URL ?? "";

/** Play Store é derivável do package; a App Store exige o ID numérico do app. */
const FALLBACK_STORE_URL = {
  android: "https://play.google.com/store/apps/details?id=com.prevenir.mais",
  /** ID 6479313427 = "Prevenir Assistencial" (bundle com.prevenir.prevenirapp). */
  ios: "https://apps.apple.com/br/app/prevenir-assistencial/id6479313427",
};

/** Timeout curto: a checagem não pode segurar a abertura do app. */
const REQUEST_TIMEOUT = 5000;

export type UpdateStatus = "up-to-date" | "optional" | "required";

export type AppUpdateMessage = {
  requiredTitle?: string;
  requiredDescription?: string;
  optionalTitle?: string;
  optionalDescription?: string;
  actionLabel?: string;
  laterLabel?: string;
};

/** Versões de uma plataforma, ou os valores comuns às duas. */
export type AppUpdateVersions = {
  /** Abaixo desta versão o app trava até atualizar. */
  minVersion?: string;
  /** Última versão publicada; acima da mínima vira só um convite. */
  latestVersion?: string;
};

export type AppUpdateConfig = AppUpdateVersions & {
  /** Desliga a verificação remotamente, sem publicar build. */
  enabled?: boolean;
  storeUrl?: Partial<Record<"ios" | "android", string>>;
  message?: AppUpdateMessage;
  /**
   * Sobrescrevem `minVersion`/`latestVersion` na plataforma correspondente.
   *
   * As lojas não publicam juntas — a App Store pode estar uma versão atrás da
   * Play Store por causa da revisão da Apple. Sem isso, anunciar a versão nova
   * mandaria metade dos usuários para uma loja que ainda não a tem.
   */
  ios?: AppUpdateVersions;
  android?: AppUpdateVersions;
};

export type AppUpdateResult = {
  status: UpdateStatus;
  currentVersion: string;
  /** Versão alvo mostrada no aviso — `latestVersion`, ou a mínima na falta dela. */
  targetVersion: string;
  storeUrl: string;
  message: AppUpdateMessage;
};

export const DEFAULT_UPDATE_MESSAGE: Required<AppUpdateMessage> = {
  requiredTitle: "Atualize o aplicativo",
  requiredDescription:
    "Esta versão do Prevenir não é mais compatível. Atualize para continuar usando o aplicativo.",
  optionalTitle: "Nova versão disponível",
  optionalDescription:
    "Uma versão mais recente do Prevenir já está na loja, com melhorias e correções.",
  actionLabel: "Atualizar agora",
  laterLabel: "Agora não",
};

/** Versão instalada, lida do app.json embutido no build. */
export function getCurrentVersion(): string {
  return Constants.expoConfig?.version ?? "0.0.0";
}

/**
 * Compara versões no formato "maior.menor.correção".
 *
 * Retorna < 0 se `a` for anterior a `b`, 0 se forem equivalentes e > 0 se `a`
 * for posterior. A comparação é numérica por segmento — "2.7.9" é anterior a
 * "2.7.48", o que a comparação de strings erraria. Segmentos ausentes contam
 * como zero ("2.8" é igual a "2.8.0") e sufixos não numéricos são ignorados.
 */
export function compareVersions(a: string, b: string): number {
  const parse = (version: string) =>
    String(version ?? "")
      .trim()
      .split(".")
      .map((part) => {
        const digits = part.match(/\d+/);
        return digits ? Number(digits[0]) : 0;
      });

  const left = parse(a);
  const right = parse(b);
  const length = Math.max(left.length, right.length);

  for (let index = 0; index < length; index += 1) {
    const diff = (left[index] ?? 0) - (right[index] ?? 0);
    if (diff !== 0) return diff;
  }

  return 0;
}

/** `true` quando a string tem pelo menos um número — descarta valores vazios. */
function isUsableVersion(version?: string): version is string {
  return typeof version === "string" && /\d/.test(version);
}

/**
 * Busca o JSON remoto. Qualquer falha (rede, timeout, HTTP != 2xx, JSON
 * inválido) devolve `null`, e o app segue sem aviso: uma indisponibilidade do
 * arquivo nunca pode barrar o acesso.
 */
export async function fetchUpdateConfig(
  url: string = APP_UPDATE_CONFIG_URL
): Promise<AppUpdateConfig | null> {
  if (!url) return null;

  const controller = new AbortController();
  const timeout = setTimeout(() => controller.abort(), REQUEST_TIMEOUT);

  try {
    const response = await fetch(url, {
      signal: controller.signal,
      // O arquivo muda a cada publicação; cache de CDN/proxy atrasaria o aviso.
      headers: { "Cache-Control": "no-cache" },
    });

    if (!response.ok) return null;

    const config = (await response.json()) as AppUpdateConfig;
    return config && typeof config === "object" ? config : null;
  } catch {
    return null;
  } finally {
    clearTimeout(timeout);
  }
}

/** Link da loja da plataforma atual, com o JSON remoto tendo prioridade. */
export function resolveStoreUrl(config: AppUpdateConfig | null): string {
  const platform = Platform.OS === "ios" ? "ios" : "android";
  return config?.storeUrl?.[platform] || FALLBACK_STORE_URL[platform];
}

/**
 * Decide o que mostrar comparando a versão instalada com a configuração.
 *
 * - instalada < `minVersion` → `required` (modal sem saída)
 * - instalada < `latestVersion` → `optional` (aviso com "agora não")
 * - caso contrário → `up-to-date`
 *
 * Sem configuração, com `enabled: false` ou sem link de loja o resultado é
 * sempre `up-to-date`: um aviso sem botão que leve à loja não ajudaria ninguém.
 */
export function resolveUpdateStatus(
  config: AppUpdateConfig | null,
  currentVersion: string = getCurrentVersion()
): AppUpdateResult {
  const storeUrl = resolveStoreUrl(config);

  const message: AppUpdateMessage = {
    ...DEFAULT_UPDATE_MESSAGE,
    ...(config?.message ?? {}),
  };

  const upToDate: AppUpdateResult = {
    status: "up-to-date",
    currentVersion,
    targetVersion: currentVersion,
    storeUrl,
    message,
  };

  if (!config || config.enabled === false || !storeUrl) return upToDate;

  const platform = Platform.OS === "ios" ? "ios" : "android";
  const minVersion = config[platform]?.minVersion ?? config.minVersion;
  const latestVersion = config[platform]?.latestVersion ?? config.latestVersion;

  if (isUsableVersion(minVersion) && compareVersions(currentVersion, minVersion) < 0) {
    return {
      ...upToDate,
      status: "required",
      targetVersion: isUsableVersion(latestVersion) ? latestVersion : minVersion,
    };
  }

  if (isUsableVersion(latestVersion) && compareVersions(currentVersion, latestVersion) < 0) {
    return { ...upToDate, status: "optional", targetVersion: latestVersion };
  }

  return upToDate;
}
